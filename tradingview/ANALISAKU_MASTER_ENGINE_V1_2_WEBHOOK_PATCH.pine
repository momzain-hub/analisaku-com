// ANALISAKU WEBSITE ALERT V1.2 — COMPACT / TOKEN SAFE
// Replacement untuk Section 15 pada ANALISAKU_MASTER_V1_1_WEBHOOK_TOKEN_SAFE.txt
// Ganti mulai header "15) ANALISAKU WEBSITE ALERT V1.1" sampai akhir script dengan blok ini.
// Payload publik hanya berisi output generik, tanpa nama metode internal.

//=====================================================================
// 15) ANALISAKU WEBSITE ALERT V1.2 — AUTO SYNC
//=====================================================================
akWebAlert = input.bool(false, "Aktifkan Website Alert", group=grpPanel)
akWebInitialSync = input.bool(true, "Kirim Snapshot Awal", group=grpPanel,
     tooltip="ON = kirim kondisi terakhir pada candle realtime close pertama setelah alert aktif.")

f_akJ(float v) =>
    na(v) ? "" : str.tostring(v, format.mintick)

string akWebPayload = "{" +
     "\"ticker\":\"" + syminfo.ticker + "\"," +
     "\"timeframe\":\"" + timeframe.period + "\"," +
     "\"trend\":\"" + akTrend + "\"," +
     "\"setup\":\"" + akSetup + "\"," +
     "\"status\":\"" + akStatus + "\"," +
     "\"entry_low\":\"" + f_akJ(akEntryLow) + "\"," +
     "\"entry_high\":\"" + f_akJ(akEntryHigh) + "\"," +
     "\"trigger\":\"" + f_akJ(priceB) + "\"," +
     "\"invalidation\":\"" + f_akJ(priceC) + "\"," +
     "\"target1\":\"" + f_akJ(fib1272) + "\"," +
     "\"target2\":\"" + f_akJ(fib1618) + "\"," +
     "\"target3\":\"" + f_akJ(fib2000) + "\"," +
     "\"price\":\"" + str.tostring(close, format.mintick) + "\"," +
     "\"updated_at\":" + str.tostring(timenow) +
     "}"

// Fingerprint keputusan. Price + updated_at tidak dimasukkan agar tidak spam setiap candle.
string akWebState =
     akTrend + "|" +
     akSetup + "|" +
     akStatus + "|" +
     f_akJ(akEntryLow) + "|" +
     f_akJ(akEntryHigh) + "|" +
     f_akJ(priceB) + "|" +
     f_akJ(priceC) + "|" +
     f_akJ(fib1272) + "|" +
     f_akJ(fib1618) + "|" +
     f_akJ(fib2000)

var string akPrevWebState = ""
var bool akInitialSent = false

bool akStateChanged = akPrevWebState != "" and akWebState != akPrevWebState
bool akNeedInitialSync = akWebInitialSync and not akInitialSent
bool akWebReady = barstate.isrealtime and barstate.isconfirmed
bool akShouldWebSend = akWebReady and (akNeedInitialSync or akStateChanged)

if akWebAlert and akShouldWebSend
    alert(akWebPayload, alert.freq_once_per_bar_close)
    akInitialSent := true

if barstate.isconfirmed
    akPrevWebState := akWebState

//=====================================================================
// END — ANALISAKU WEBSITE ALERT V1.2
//=====================================================================
